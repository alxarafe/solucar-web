#!/usr/bin/env bash
# bin/up — Start Solucar development environment

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

cd "${PROJECT_ROOT}"

export SOLUCAR_WEB_PORT="${SOLUCAR_WEB_PORT:-44200}"

echo "Starting Solucar development server on http://127.0.0.1:${SOLUCAR_WEB_PORT}"

docker compose up --build --detach

echo "Solucar is starting. Access it at http://127.0.0.1:${SOLUCAR_WEB_PORT}"
echo "Logs: docker compose logs -f"