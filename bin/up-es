#!/usr/bin/env bash
# bin/up-es — Start Solucar development environment in Spanish

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

cd "${PROJECT_ROOT}"

export SOLUCAR_WEB_PORT="${SOLUCAR_WEB_PORT:-44200}"

echo "Starting Solucar development server (Spanish) on http://127.0.0.1:${SOLUCAR_WEB_PORT}"

docker compose run --rm --service-ports solucar \
  npx ng serve --configuration development-es --host 0.0.0.0 --port 4200

echo "Solucar stopped."