#!/usr/bin/env bash
# bin/test — Run tests in Docker environment

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

cd "${PROJECT_ROOT}"

echo "Running tests in Docker..."

docker compose run --rm solucar npm test -- --watch=false