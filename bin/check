#!/usr/bin/env bash
# bin/check — Complete local validation authority for Solucar

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

cd "${PROJECT_ROOT}"

echo "=== Solucar local validation ==="
echo ""

# 1. Reproducible dependency install
echo "[1/4] Installing dependencies (npm ci)..."
docker compose run --rm solucar npm ci
echo ""

# 2. TypeScript check
echo "[2/4] TypeScript check..."
docker compose run --rm solucar npx tsc --noEmit
echo ""

# 3. Tests
echo "[3/4] Running tests..."
docker compose run --rm solucar npm test -- --watch=false
echo ""

# 4. Production build
echo "[4/4] Production build..."
docker compose run --rm solucar npm run build
echo ""

echo "=== All checks passed ==="